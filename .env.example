# Frontend - Stripe
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Frontend - Sentry (Error Tracking)
VITE_SENTRY_DSN=

# Frontend - API (optional if using a separate checkout server)
VITE_API_URL=http://localhost:4242

# Frontend - Checkout (optional if using a different checkout endpoint)
VITE_CHECKOUT_URL=

# Frontend - Checkout Status (optional if status verification is hosted elsewhere)
VITE_CHECKOUT_STATUS_URL=

# Backend - Stripe Secret
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Backend - Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Order Notifications — emails every completed sale.
# Without all three, the webhook silently skips the email and just logs it.
# ORDER_NOTIFICATION_EMAIL accepts a comma-separated list of recipients.
# ORDER_NOTIFICATION_FROM must be on a domain verified with Resend.
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=armonnasiri@gmail.com,info@sattarimusic.com
ORDER_NOTIFICATION_FROM=orders@sattarimusic.com

# Local development only: where `npm run dev:api` keeps its Netlify Blobs data
# (orders, stock, holds, bookings). Optional.
LOCAL_BLOBS_PATH=

# Admin order lookup (/api/admin/orders) takes a staff session token from
# /api/staff/login; the old static ORDER_LOOKUP_TOKEN is no longer read.

# Studio bookings. Requests open only when STUDIO_BOOKING_ENABLED=true AND hours,
# booking email, Twilio SMS, Stripe and staff sign-in are all configured.
# STUDIO_BOOKING_DAYS is a comma-separated list, 0 = Sunday.
STUDIO_BOOKING_ENABLED=
# true = offer 1..N-hour sessions up to the full day instead of 1–4 hours.
STUDIO_BOOKING_EXTRA_HOURS=
STUDIO_BOOKING_OPEN_HOUR=
STUDIO_BOOKING_CLOSE_HOUR=
STUDIO_BOOKING_DAYS=
# Optional overrides; fall back to the SERVICE_INQUIRY_* then ORDER_NOTIFICATION_* values.
STUDIO_BOOKING_FROM=
STUDIO_BOOKING_EMAIL=
# Comma-separated E.164 numbers that get a text for each new booking request.
STUDIO_BOOKING_SMS_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Build only: inventory used for prerendered product pages. Defaults to the live
# site; if unreachable the build falls back to the built-in catalog with a warning.
PRERENDER_INVENTORY_URL=

# Optional rebuild trigger that rebuilds the prerendered product pages and
# sitemap after staff edit the
# catalog, change stock so an item sells out or comes back, restore a backup, or
# a sale takes the last unit. Requests are batched: one build once edits have
# been quiet for 5 minutes, at most one an hour (each build uses deploy credits).
# Leave empty to never rebuild automatically.
# Deploys come from GitHub Actions (docs/DEPLOYMENT.md), so point this at the
# Build & Deploy workflow's dispatch endpoint and set a token that may run it
# (fine-grained, this repository, "Actions: Read and write"):
#   https://api.github.com/repos/<owner>/<repo>/actions/workflows/build-deploy.yml/dispatches
# A Netlify build hook URL works only if NETLIFY_PRODUCTION_BUILDS=on.
BUILD_HOOK_URL=
BUILD_HOOK_TOKEN=
# Branch the workflow rebuilds (default main).
BUILD_HOOK_REF=

# Optional canonical site URL for Stripe return links (defaults to Netlify's URL).
SITE_URL=

# Service inquiries (optional; fall back to the ORDER_NOTIFICATION_* values above)
SERVICE_INQUIRY_FROM=
SERVICE_INQUIRY_TO=

# Staff inventory page (required to use the stock editor)
# Generate all four with (it asks for the password at a hidden prompt; never
# put the password on the command line):
#   node scripts/hash-staff-password.mjs "username"
# The password itself is never stored — only the scrypt hash.
# Changing STAFF_SESSION_SECRET signs every staff member out immediately.
# The staff page's "Sign out everywhere" does the same without a redeploy.
STAFF_USERNAME=
STAFF_PASSWORD_SALT=
STAFF_PASSWORD_HASH=
STAFF_SESSION_SECRET=

# Key for hashing visitor IP addresses before they are stored (booking and
# sign-in rate limits). Optional: falls back to STAFF_SESSION_SECRET. Use a
# long random value, e.g. `openssl rand -hex 32`. Changing it only resets the
# rate-limit counters.
IP_HASH_SECRET=

# Instagram feed (optional; without it the feed shows its fallback message)
INSTAGRAM_ACCESS_TOKEN=

# Frontend - Inventory endpoint (optional override for local dev)
VITE_INVENTORY_URL=

# Backend - URLs & Config
CLIENT_URL=http://localhost:5173
PORT=4242

