{
  "name": "sattari-custom-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/checkout-server.js",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test:seo": "node scripts/check-seo.mjs",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "test": "vitest --run --passWithNoTests",
    "test:meter-qualification": "node scripts/qualify-loudness.mjs",
    "test:tempo-qualification": "node scripts/qualify-tempo.mjs",
    "test:studio-audio": "node scripts/run-studio-audio-qa.mjs",
    "test:studio-release": "node scripts/studio-release-gate.mjs",
    "test:sattari-market-route": "vitest run src/components/SattariMarketPage.route.test.jsx",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@netlify/blobs": "10.7.13",
    "@sentry/react": "^7.91.0",
    "cors": "^2.8.6",
    "demucs-web": "1.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.4",
    "react-router-dom": "^6.30.1",
    "resend": "^6.1.3",
    "stripe": "^17.3.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^3.2.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.0.2",
    "playwright": "1.62.1",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
